<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Game của tôi</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{
  margin:0;width:100%;height:100%;overflow:hidden;
  background:#070b12;color:#fff;font-family:Arial,sans-serif
}
#app{
  width:100%;height:100%;
  background:linear-gradient(145deg,#142238,#070b12)
}
#top{
  height:62px;background:#151d2b;
  display:flex;align-items:center;gap:10px;padding:8px 12px
}
#back{
  width:42px;height:42px;border:0;border-radius:50%;
  background:transparent;color:#fff;font-size:30px
}
#title{font-size:18px;font-weight:bold}
#body{
  height:calc(100% - 62px);
  overflow:auto;padding:16px
}
#search{
  width:100%;height:48px;border:0;outline:0;
  border-radius:24px;background:#202936;color:#fff;
  padding:0 17px;font-size:15px;margin-bottom:15px
}
#games{display:flex;flex-direction:column;gap:12px}
.game{
  background:#192230;border-radius:16px;
  padding:15px;display:flex;align-items:center;gap:13px
}
.gameicon{
  width:58px;height:58px;border-radius:15px;
  background:#293950;display:flex;align-items:center;
  justify-content:center;font-size:29px;flex-shrink:0
}
.info{flex:1;min-width:0}
.name{font-weight:bold;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta{font-size:12px;color:#9faaba;margin-top:6px}
.action{
  border:0;border-radius:10px;background:#4285f4;
  color:#fff;padding:10px 13px
}
.empty{
  text-align:center;color:#9da8b8;
  padding:50px 20px;display:none
}
#add{
  width:100%;height:48px;margin-bottom:15px;
  border:0;border-radius:14px;background:#26364d;
  color:#fff;font-size:15px
}
#fileInput{display:none}
#message{
  position:fixed;left:15px;right:15px;bottom:85px;
  padding:13px;border-radius:13px;background:#263247;
  text-align:center;display:none;z-index:20
}
</style>
</head>

<body>

<div id="app">

<div id="top">
  <button id="back" onclick="quayLai()">‹</button>
  <div id="title">🎮 Game của tôi</div>
</div>

<div id="body">

<input id="search"
       placeholder="Tìm game..."
       oninput="timGame()">

<button id="add" onclick="document.getElementById('fileInput').click()">
  ＋ Thêm APK từ thiết bị
</button>

<input id="fileInput"
       type="file"
       accept=".apk,application/vnd.android.package-archive"
       onchange="themAPK(event)">

<div id="games"></div>

<div id="empty">
  Chưa có game APK nào.
</div>

</div>

<div id="message"></div>

</div>

<script>
const STORAGE_KEY="ddth_game_apk";
let games=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");

/*
  Lưu thông tin APK vào danh sách.
  Trình duyệt không cho lưu trực tiếp toàn bộ tệp APK
  vào localStorage, vì vậy dữ liệu lớn cần được giữ
  trong bộ nhớ của trình duyệt.
*/

function themAPK(event){

  const file=event.target.files[0];

  if(!file)return;

  if(!file.name.toLowerCase().endsWith(".apk")){
    thongBao("Vui lòng chọn tệp APK.");
    return;
  }

  const game={
    id:Date.now(),
    name:file.name.replace(/\.apk$/i,""),
    fileName:file.name,
    size:file.size,
    type:file.type||"application/vnd.android.package-archive"
  };

  games.push(game);

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(games)
  );

  hienThi();

  thongBao(
    "Đã thêm "+game.name+" vào Game của tôi."
  );

  event.target.value="";
}


function hienThi(){

  const container=document.getElementById("games");
  const empty=document.getElementById("empty");

  container.innerHTML="";

  if(games.length===0){
    empty.style.display="block";
    return;
  }

  empty.style.display="none";

  games.forEach(game=>{

    const item=document.createElement("div");
    item.className="game";
    item.dataset.name=game.name.toLowerCase();

    item.innerHTML=`
      <div class="gameicon">🎮</div>

      <div class="info">
        <div class="name"></div>
        <div class="meta">
          APK • ${dungLuong(game.size)}
        </div>
      </div>

      <button class="action">
        Mở
      </button>
    `;

    item.querySelector(".name").textContent=game.name;

    item.querySelector(".action")
      .onclick=()=>moGame(game);

    container.appendChild(item);
  });
}


function moGame(game){

  /*
    APK thật không thể được thực thi bởi
    JavaScript/Safari như một ứng dụng Android.

    Vì vậy nút này mở tệp APK nếu trình duyệt
    cho phép xử lý loại tệp đó.
  */

  thongBao(
    "Đây là APK Android thật. DDTH có thể quản lý/tải tệp, nhưng không thể chạy APK trực tiếp trong trình duyệt."
  );
}


function timGame(){

  const q=document
    .getElementById("search")
    .value
    .toLowerCase()
    .trim();

  const items=document
    .querySelectorAll(".game");

  let count=0;

  items.forEach(item=>{

    const match=
      item.dataset.name.includes(q);

    item.style.display=
      match?"flex":"none";

    if(match)count++;
  });

  document.getElementById("empty").style.display=
    count===0?"block":"none";
}


function dungLuong(bytes){

  if(!bytes)return "Không rõ dung lượng";

  if(bytes<1024)
    return bytes+" B";

  if(bytes<1024*1024)
    return (bytes/1024).toFixed(1)+" KB";

  if(bytes<1024*1024*1024)
    return (bytes/1024/1024).toFixed(1)+" MB";

  return (bytes/1024/1024/1024).toFixed(2)+" GB";
}


function thongBao(text){

  const box=document.getElementById("message");

  box.textContent=text;
  box.style.display="block";

  clearTimeout(window.__msg);

  window.__msg=setTimeout(()=>{
    box.style.display="none";
  },3500);
}


function quayLai(){

  if(history.length>1){
    history.back();
  }else{
    window.location.href="index.html";
  }
}

hienThi();
</script>

</body>
</html>