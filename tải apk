<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>DDTH Đám Mây - Tải APK</title>

<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{
  margin:0;width:100%;height:100%;overflow:hidden;
  background:#05080d;color:#fff;font-family:Arial,sans-serif
}
#app{
  width:100%;height:100%;
  background:linear-gradient(145deg,#111c2e,#070b12)
}
#top{
  height:62px;background:#151d2b;
  display:flex;align-items:center;gap:10px;padding:8px 12px
}
button{
  border:0;color:#fff;cursor:pointer
}
.back{
  width:42px;height:42px;border-radius:50%;
  background:transparent;font-size:30px
}
.title{font-size:18px;font-weight:bold}
#body{
  height:calc(100% - 62px);overflow:auto;padding:18px
}
.search{
  height:48px;display:flex;align-items:center;
  background:#202936;border-radius:24px;padding:4px 8px;
  margin-bottom:18px
}
.search input{
  flex:1;border:0;outline:0;background:transparent;
  color:#fff;padding:0 12px;font-size:15px
}
.card{
  background:#192230;border-radius:16px;padding:17px;
  margin-bottom:12px
}
.row{
  display:flex;align-items:center;gap:14px
}
.apkicon{
  width:55px;height:55px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  background:#26364e;font-size:28px
}
.info{flex:1}
.name{font-weight:bold;font-size:16px}
.size{font-size:12px;color:#9da8b8;margin-top:5px}
.download{
  background:#4285f4;padding:10px 14px;
  border-radius:10px;font-size:14px
}
.progress{
  display:none;height:7px;background:#303a49;
  border-radius:5px;margin-top:15px;overflow:hidden
}
.progress div{
  height:100%;width:0;background:#4285f4;
  transition:width .15s
}
.status{
  margin-top:8px;font-size:12px;color:#aeb8c8
}
.empty{
  display:none;text-align:center;color:#9da8b8;
  padding:30px
}
</style>
</head>

<body>

<div id="app">

<div id="top">
  <button class="back" onclick="veTrangTruoc()">‹</button>
  <div class="title">Tệp APK</div>
</div>

<div id="body">

  <div class="search">
    <input id="search"
           placeholder="Tìm ứng dụng APK..."
           oninput="locAPK()">
  </div>

  <!-- APK thật được thêm bằng JavaScript hoặc URL thật -->
  <div id="list">

    <div class="card" data-name="ddth game">

      <div class="row">

        <div class="apkicon">🤖</div>

        <div class="info">
          <div class="name">DDTH Game</div>
          <div class="size">Tệp APK</div>
        </div>

        <button class="download"
                onclick="taiAPK(this,'DDTH-Game.apk','')">
          Tải
        </button>

      </div>

      <div class="progress">
        <div></div>
      </div>

      <div class="status"></div>

    </div>

  </div>

  <div class="empty" id="empty">
    Không tìm thấy APK.
  </div>

</div>

</div>

<script>

/*
  Đặt URL APK thật vào tham số thứ ba của taiAPK().
  Ví dụ:
  taiAPK(nut,"ung-dung.apk","https://ten-mien-cua-ban/ung-dung.apk")
*/

async function taiAPK(button,fileName,url){

  const card=button.closest(".card");
  const progress=card.querySelector(".progress");
  const bar=progress.querySelector("div");
  const status=card.querySelector(".status");

  if(!url){
    status.textContent=
      "Chưa có URL APK thật. Hãy gắn tệp APK hoặc URL APK vào mã.";
    return;
  }

  button.disabled=true;
  button.textContent="Đang tải...";
  progress.style.display="block";
  bar.style.width="0%";
  status.textContent="Đang kết nối...";

  try{

    const response=await fetch(url);

    if(!response.ok)
      throw new Error("Không tải được tệp");

    const total=Number(
      response.headers.get("content-length")
    )||0;

    const reader=response.body.getReader();
    const chunks=[];
    let received=0;

    while(true){

      const {done,value}=await reader.read();

      if(done)break;

      chunks.push(value);
      received+=value.length;

      if(total){
        const percent=
          Math.round(received/total*100);

        bar.style.width=percent+"%";
        status.textContent=
          "Đang tải "+percent+"%";
      }else{
        status.textContent=
          "Đang tải "+formatBytes(received);
      }
    }

    const blob=new Blob(chunks,{
      type:"application/vnd.android.package-archive"
    });

    const link=document.createElement("a");

    link.href=URL.createObjectURL(blob);
    link.download=fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(()=>{
      URL.revokeObjectURL(link.href);
    },2000);

    bar.style.width="100%";
    status.textContent="Tải xuống hoàn tất.";
    button.textContent="Đã tải";

  }catch(error){

    status.textContent=
      "Không tải được APK. Kiểm tra URL hoặc máy chủ.";
    button.disabled=false;
    button.textContent="Tải";
  }
}


/* Tìm APK */
function locAPK(){

  const q=
    document.getElementById("search")
    .value.toLowerCase().trim();

  const cards=
    document.querySelectorAll(".card");

  let visible=0;

  cards.forEach(card=>{

    const name=
      card.dataset.name||"";

    const show=name.includes(q);

    card.style.display=
      show?"block":"none";

    if(show)visible++;
  });

  document.getElementById("empty")
    .style.display=
      visible?"none":"block";
}


/* Định dạng dung lượng */
function formatBytes(bytes){

  if(bytes<1024)
    return bytes+" B";

  if(bytes<1024*1024)
    return (bytes/1024).toFixed(1)+" KB";

  return (bytes/1024/1024).toFixed(1)+" MB";
}


/* Quay lại */
function veTrangTruoc(){

  if(history.length>1)
    history.back();
  else
    window.location.href="index.html";
}

</script>

</body>
</html>